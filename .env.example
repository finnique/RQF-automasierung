# Copy this file to .env and fill in your own values.
# .env is gitignored -- never commit real keys.
#
# One API key per PROVIDER, not per model: this single OPENAI_API_KEY
# authenticates calls to whichever model EXTRACT_MODEL names below
# (gpt-5-mini, gpt-4o, ...). You'd only add a second key here if you
# started calling a second provider (e.g. ANTHROPIC_API_KEY).

OPENAI_API_KEY=sk-...

# Which OpenAI model extract.py calls. Must have a pricing entry in
# MODEL_PRICING in extract.py.
EXTRACT_MODEL=gpt-5-mini

# Optional -- defaults shown.
EXTRACT_TIMEOUT_SECONDS=60
EXTRACT_MAX_ATTEMPTS=5

# Web demo only (web/main.py) -- guardrails since this hits OPENAI_API_KEY
# on every visitor's request. Optional, defaults shown.
DEMO_DAILY_BUDGET_USD=2.00
DEMO_RATE_LIMIT_PER_HOUR=5
DEMO_MAX_EMAIL_CHARS=6000
